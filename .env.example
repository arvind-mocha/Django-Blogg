# Generate SECRET_KEY with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local HTTP only. For public deployment, change these to true/31536000.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
TRUST_PROXY_HEADERS=false

# Local reset emails appear in logs. Use SMTP before public deployment.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=
EMAIL_PASS=
DEFAULT_FROM_EMAIL=webmaster@localhost
