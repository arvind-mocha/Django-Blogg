# Only these application files may enter the image build context.
**
!requirements.txt
!manage.py
!Mysite/
!Mysite/*.py
!blog/
!blog/**/*.py
!blog/templates/**
!blog/static/**
!usersapp/
!usersapp/**/*.py
!usersapp/templates/**
!docker/
!docker/entrypoint.sh

# Directory exceptions above can re-include children; always exclude these.
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.sqlite3*
**/*.log
**/.env*
**/.git
**/.idea
**/.aws
